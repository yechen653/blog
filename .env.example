# 用法：复制成 .env 后按需修改
# cp .env.example .env

PROJECT_NAME=Blog API
API_V1_PREFIX=/api/v1

# 连接串格式：<方言>+<驱动>://<用户>:<密码>@<主机>:<端口>/<库名>?charset=utf8mb4
# 本项目用 Docker 里的 MySQL（起库命令见复习手册 B.6）；
# 改数据库只需要改这一行，ORM 代码一行都不用动。
DATABASE_URL=mysql+pymysql://blog:blog123456@127.0.0.1:3306/blog?charset=utf8mb4

# 备选一：零配置的 SQLite（不想开 MySQL 时临时切回来）
# DATABASE_URL=sqlite:///./blog.db
# 备选二：PostgreSQL
# DATABASE_URL=postgresql+psycopg://user:pwd@127.0.0.1:5432/blog

# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-generate-your-own-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Redis（阶段14：浏览量防刷）=====
# 起库命令（本机 Docker，不设密码）：
#   docker run -d --name blog-redis -p 6379:6379 redis:7-alpine
# 连接串末尾的 /0 是"第 0 号库"：Redis 默认有 16 个库，本项目只用 0 号。
REDIS_URL=redis://127.0.0.1:6379/0

# 防刷窗口（秒）：同一 IP 这么长时间内重复浏览同一篇，只计一次；0 = 关闭
VIEW_DEDUP_SECONDS=60
